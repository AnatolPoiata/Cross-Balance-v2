# Python
__pycache__/
*.pyc
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Data (raw downloads and generated caches are not committed)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Large generated artifacts (PR curve PNGs ARE tracked -- article/draft.md
# embeds specific ones directly, and they're small enough to commit)
results/**/*.parquet
*.pkl

# Reference literature (large binary corpus, not source)
references/

# OS
.DS_Store
._*
