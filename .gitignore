# Python
__pycache__/
*.pyc
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Project datasets are versioned with Git LFS (see .gitattributes).

# Large generated artifacts (PR curve PNGs ARE tracked -- article/draft.md
# embeds specific ones directly, and they're small enough to commit)
results/**/*.parquet
*.pkl

# Reference literature (large binary corpus, not source)
references/

# OS
.DS_Store
._*

# Keep processed dataset files despite the generated-artifact rule above.
!data/**/*.parquet
